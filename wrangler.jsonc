{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "beefcake-api",
  "main": "server/src/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    { "pattern": "api.orgutveckling.se", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "beefcake",
      "database_id": "c42ed108-8d70-4380-8e6d-41bd812ac2b5",
      "migrations_dir": "server/migrations"
    }
  ],
  "vars": {
    "AUTH_MODE": "firebase",
    "FIREBASE_PROJECT_ID": "beefcake-4865a",
    "FRONTEND_ORIGINS": "https://orgutveckling.se,https://www.orgutveckling.se",
    "APP_URL": "https://orgutveckling.se/beefcake/"
  },
  // Latmask-mejlet 19:00 svensk sommartid, 18:00 vintertid (cron är UTC)
  "triggers": { "crons": ["0 17 * * *"] },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 }
  }
}
